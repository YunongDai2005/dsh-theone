# Normal plugin installation reuses the model/API credentials configured in DSH.
THEONE_HISTORY_CATALOG=true
THEONE_ROUTER_MODE=llm
THEONE_WEB_PORT=3018
# Optional fixed DSH model override (set both):
# THEONE_WORKER_PROVIDER=deepseek-official
# THEONE_WORKER_MODEL=deepseek-flash
# Only the local development profile (npm run start:local) needs a key; it is passed to DSH as DEEPSEEK_API_KEY.
# THEONE_ROUTER_API_KEY=your-key
