# Fill locally with genuine Sandbox app credentials; never use Live credentials.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# Sandbox buyer email from your developer dashboard; never a real customer.
SANDBOX_RECIPIENT=
# Trusted OpenAI-compatible provider endpoint, e.g. your configured Nebius /v1 base.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# OpenCode Go (verified November 12, 2026):
# MODEL_BASE_URL=https://opencode.ai/inference/go/openai/v1
# MODEL_NAME=deepseek-v4.1-flash
# MODEL_REASONING_STYLE=openai
# For Nebius Nemotron only; omit for providers that do not support this option.
MODEL_DISABLE_THINKING=false
# none: compatible generic provider; openai: quick reasoning_effort=none;
# deepseek: native thinking.type disabled for quick/plan, enabled for recheck.
MODEL_REASONING_STYLE=none
PORT=3047
# Optional private JSON topic catalog with id/title/summary/recipient fields.
# THEONE_TOPICS_FILE=topics.private.json
